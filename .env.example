# OPENAI_API_KEY=...
# Set only for an OpenAI-compatible proxy. Requests then go over plain HTTP with
# the whole conversation each turn, not the chained websocket used against OpenAI.
# OPENAI_BASE_URL=https://proxy.example.com/v1
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENROUTER_API_KEY=...
# ARTICRAFT_PROVIDER=openai
# ARTICRAFT_MODEL=gpt-5.6
# ARTICRAFT_REASONING_EFFORT=xhigh
# ARTICRAFT_OPENAI_MAX_ATTEMPTS=4
# ARTICRAFT_OPENAI_REQUEST_TIMEOUT_SECONDS=900
# ARTICRAFT_ANTHROPIC_MODEL=claude-sonnet-5
# ARTICRAFT_ANTHROPIC_MAX_ATTEMPTS=4
# ARTICRAFT_ANTHROPIC_REQUEST_TIMEOUT_SECONDS=3600
# ARTICRAFT_GEMINI_MODEL=gemini-3.6-flash
# ARTICRAFT_GEMINI_MAX_ATTEMPTS=4
# ARTICRAFT_GEMINI_REQUEST_TIMEOUT_SECONDS=900
# ARTICRAFT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ARTICRAFT_OPENROUTER_MAX_ATTEMPTS=4
# ARTICRAFT_OPENROUTER_REQUEST_TIMEOUT_SECONDS=900
# OPENROUTER_HTTP_REFERER=...
# OPENROUTER_APP_TITLE=articraft
# ARTICRAFT_COMPILE_TIMEOUT_SECONDS=900
